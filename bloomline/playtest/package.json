{
  "name": "bloomline-playtest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts test",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "solve": "node scripts/solve-levels.ts",
    "cap:sync": "pnpm build && cap sync",
    "android": "pnpm cap:sync && cap open android",
    "ios": "pnpm cap:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.4",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
